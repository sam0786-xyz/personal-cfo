# --- Required ---
GEMINI_API_KEY=your_gemini_api_key
GCP_PROJECT=your_gcp_project_id
CFO_ACCESS_TOKEN=long_random_private_dashboard_token

# Local development only: skip auth entirely
# CFO_AUTH_DISABLED=true

# --- Webhook security (recommended in production) ---
# PUBSUB_AUDIENCE=https://your-domain.com/gmail-webhook
# PUBSUB_SERVICE_ACCOUNT=pubsub-push@your-project.iam.gserviceaccount.com

# --- Optional tuning ---
# BANK_ALERT_SENDER=alerts@axis.bank.in
# CFO_DEFAULT_BALANCE=5000
# CFO_TARGET_DATE=2026-12-31
# CFO_RUNWAY_HORIZON_DAYS=30
# CFO_ALLOWED_ORIGINS=https://your-domain.com,http://localhost:8000
# GEMINI_MODEL=gemini-2.5-flash

# --- Asset model seeds (all default to 0) ---
# CFO_LIQUID_SEED_PRINCIPAL=0
# CFO_SEED_AXIS_EDGE_POINTS=0
# CFO_SEED_GITHUB_CREDITS_USD=0
# CFO_DEFAULT_API_BURN_USD=0
